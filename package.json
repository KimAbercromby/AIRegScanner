{
  "name": "ai-reg-scanner",
  "version": "0.8.0",
  "description": "Regulatory horizon scanner for an English single-tier local authority. Flat layout: every file at the repository root so it can be uploaded without folders.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test scan.test.mjs framework-check.test.mjs",
    "scan": "node scan.mjs",
    "verify": "node scan.mjs --dry-run",
    "resolve": "node resolve.mjs",
    "issues": "node issues.mjs",
    "diary": "node diary.mjs",
    "smoke": "node smoke.mjs",
    "triage": "node triage.mjs",
    "discover": "node discover.mjs",
    "framework": "node framework-check.mjs",
    "sample": "node sample.mjs",
    "sample:clear": "node sample.mjs --clear",
    "reset:phase1": "node reset-phase1.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "node-html-parser": "7.0.1"
  }
}
